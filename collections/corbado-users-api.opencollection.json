{
  "opencollection": "1.0.0",
  "info": {
    "name": "Corbado Backend ConnectTokens Users API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backendapi.corbado.io/v2/users",
            "params": [
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Field and direction to sort by, e.g. created:desc."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Repeatable filter expressions, e.g. status:eq:active."
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List users"
        },
        {
          "info": {
            "name": "Create a new user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://backendapi.corbado.io/v2/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new user"
        },
        {
          "info": {
            "name": "Retrieve a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backendapi.corbado.io/v2/users/:userID",
            "params": [
              {
                "name": "userID",
                "value": "",
                "type": "path",
                "description": "The Corbado user ID (e.g. usr-4693224802260150919)."
              }
            ]
          },
          "docs": "Retrieve a user"
        },
        {
          "info": {
            "name": "Update a user",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://backendapi.corbado.io/v2/users/:userID",
            "params": [
              {
                "name": "userID",
                "value": "",
                "type": "path",
                "description": "The Corbado user ID (e.g. usr-4693224802260150919)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a user"
        },
        {
          "info": {
            "name": "Delete a user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://backendapi.corbado.io/v2/users/:userID",
            "params": [
              {
                "name": "userID",
                "value": "",
                "type": "path",
                "description": "The Corbado user ID (e.g. usr-4693224802260150919)."
              }
            ]
          },
          "docs": "Delete a user"
        },
        {
          "info": {
            "name": "List passkeys for user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backendapi.corbado.io/v2/users/:userID/credentials",
            "params": [
              {
                "name": "userID",
                "value": "",
                "type": "path",
                "description": "The Corbado user ID (e.g. usr-4693224802260150919)."
              }
            ]
          },
          "docs": "List passkeys for user"
        },
        {
          "info": {
            "name": "Delete passkey",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://backendapi.corbado.io/v2/users/:userID/credentials/:credentialID",
            "params": [
              {
                "name": "userID",
                "value": "",
                "type": "path",
                "description": "The Corbado user ID (e.g. usr-4693224802260150919)."
              },
              {
                "name": "credentialID",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete passkey"
        }
      ]
    }
  ],
  "bundled": true
}